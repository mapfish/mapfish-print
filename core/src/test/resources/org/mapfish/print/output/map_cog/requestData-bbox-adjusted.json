{
  "layout": "main",
  "outputFormat": "cog",
  "attributes": {
    "map": {
      "bbox": [
        97.5,
        -0.5,
        107.5,
        2.5
      ],
      "useAdjustBounds": true,
      "projection": "CRS:84",
      "useNearestScale": false,
      "dpi": 72,
      "layers": [
        {
          "type": "geojson",
          "style": "polygon",
          "renderAsSvg": false,
          "geoJson": @@importFile(geojson.json)@@
        }
      ]
    }
  }
}